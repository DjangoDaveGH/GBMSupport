rules_version = '2';

// Ticket attachments live at attachments/{uploaderUid}/{filename}. Storage
// rules can't cheaply cross-reference which ticket an attachment belongs to
// (no collection queries here, only get()/exists() on known paths), so
// access is approximated by uid ownership plus support-side custom claims —
// consistent with firestore.rules, which is the authoritative boundary for
// who can see a given ticket (and therefore its attachment URLs) at all.
service firebase.storage {
  match /b/{bucket}/o {
    function isSignedIn() {
      return request.auth != null;
    }

    // Must match firestore.rules' isSupportSide() exactly — vendor_support
    // is deliberately excluded there (vendors only see tickets explicitly
    // escalated to them), and attachment/report access here is meant to
    // approximate that same boundary, not grant vendors a wider one.
    function isSupportSide() {
      return isSignedIn() && request.auth.token.role in [
        'support_coordinator', 'functional_lead', 'technical_lead', 'pfm_management'
      ];
    }

    match /attachments/{uploaderUid}/{fileName} {
      allow read: if isSignedIn() && (request.auth.uid == uploaderUid || isSupportSide());
      allow write: if isSignedIn() && request.auth.uid == uploaderUid
        && request.resource.size < 15 * 1024 * 1024;
      allow delete: if false;
    }

    // Anonymous guest uploads are written by the submitGuestTicket callable
    // via the Admin SDK. Only signed-in support staff may read these objects;
    // clients cannot upload into or enumerate the guest attachment namespace.
    match /attachments/guest/{ticketId}/{fileName} {
      allow read: if isSupportSide();
      allow write, delete: if false;
    }

    // Ticket chat image attachments (TicketChatScreen), at
    // chat/{uploaderUid}/{filename} — same uid/support-side approximation as
    // attachments above. In practice the Firestore activity doc's own read
    // rules (canViewTicketChat) are what actually gate which participants
    // ever see a given attachmentUrl at all; the download-token URL those
    // participants then load bypasses these Storage rules entirely, same as
    // any Firebase Storage download URL. This block only needs to exist so
    // the upload itself isn't denied by the default no-match deny.
    match /chat/{uploaderUid}/{fileName} {
      allow read: if isSignedIn() && (request.auth.uid == uploaderUid || isSupportSide());
      allow write: if isSignedIn() && request.auth.uid == uploaderUid
        && request.resource.size < 15 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if false;
    }

    // Profile photos are readable by signed-in users so avatars can be shown
    // throughout the support centre. Each user can overwrite only their own
    // fixed avatar path; deleting is intentionally not exposed yet.
    match /profile_photos/{userId}/avatar {
      allow read: if isSignedIn();
      allow write: if isSignedIn()
        && request.auth.uid == userId
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if false;
    }

    // The app-wide branding logo (desktop Settings -> General). Same
    // pfm_management-only write boundary as config/general in
    // firestore.rules, which is what actually stores the resulting URL.
    match /branding/logo {
      allow read: if isSignedIn();
      allow write: if isSignedIn()
        && request.auth.token.role == 'pfm_management'
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if false;
    }

    // Exported report PDFs, scoped strictly to the admin who generated
    // them — same owner-only boundary as report_views in firestore.rules,
    // which is what actually stores the resulting download URL.
    match /reports/{uploaderUid}/{fileName} {
      allow read: if isSignedIn() && request.auth.uid == uploaderUid;
      allow write: if isSignedIn()
        && request.auth.uid == uploaderUid
        && isSupportSide()
        && request.resource.size < 10 * 1024 * 1024;
      allow delete: if false;
    }
  }
}
