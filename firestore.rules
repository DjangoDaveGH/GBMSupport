rules_version = '2';

// Hyperion Support — Firestore security rules v1.
//
// This is the real access boundary (Section 3 of the project brief): the
// app's client-side query scoping (see TicketRepository.scopedQuery) is a
// UX/cost optimization, not a security control. These rules must hold even
// if the client is compromised or bypassed entirely.
//
// Role and institution are read from Firebase Auth custom claims
// (`role`, `institutionId`), NOT from the `users/{uid}` Firestore document.
// Claims are set server-side by the `adminCreateUser` Cloud Function (Admin
// SDK) at account provisioning time — never from the client. See
// DECISIONS.md ("Custom claims vs. Firestore doc for role/institution").
//
// Roles (must match core/models/enums.dart UserRole.wireValue):
//   end_user, focal_person, support_coordinator, functional_lead,
//   technical_lead, pfm_management, vendor_support

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function role() {
      return request.auth.token.role;
    }

    function institutionId() {
      return request.auth.token.institutionId;
    }

    function isInstitutionAdmin() {
      return isSignedIn() && role() == 'pfm_management';
    }

    function isTenantScopedSupportRole() {
      return role() in [
        'support_coordinator', 'functional_lead',
        'technical_lead', 'vendor_support'
      ];
    }

    function hasAllowedSystem(system) {
      return isSignedIn()
        && (
          (request.auth.token.systems != null
            && system in request.auth.token.systems
            // Support staff are tenant-scoped: GBMS is separate from the
            // GHANEPS/GIFMIS workspace. Keep this check in rules as well as
            // provisioning so a forged or stale mixed claim cannot cross the
            // boundary.
            && (isTenantScopedSupportRole()
                ? (system == 'gbms'
                    ? !request.auth.token.systems.hasAny(['ghaneps', 'gifmis'])
                    : !('gbms' in request.auth.token.systems))
                : true))
          // Existing accounts may predate the systems claim. Preserve their
          // original tenant scope until an administrator refreshes claims.
          || (request.auth.token.systems == null
            && (
              (role() == 'support_coordinator' && system in ['ghaneps', 'gifmis'])
              || (role() in ['functional_lead', 'technical_lead', 'vendor_support']
                && system == 'gbms')
            ))
        );
    }

    // Tickets created before multi-system support do not have a `system`
    // field. They are GBMS tickets, matching Ticket.fromMap's compatibility
    // default in the client.
    function ticketSystem(ticket) {
      return ticket.keys().hasAny(['system']) ? ticket.system : 'gbms';
    }

    function userHasAllowedSystem(user) {
      // Legacy user profiles without a systems array are GBMS profiles. They
      // remain visible to GBMS staff, but never to GHANEPS/GIFMIS-only staff.
      return user.keys().hasAny(['systems'])
        ? request.auth.token.systems != null
          && user.systems.hasAny(request.auth.token.systems)
          && (!isTenantScopedSupportRole()
            || (('gbms' in request.auth.token.systems)
                ? !user.systems.hasAny(['ghaneps', 'gifmis'])
                : !('gbms' in user.systems)))
        : request.auth.token.systems != null
          && 'gbms' in request.auth.token.systems;
    }

    function requesterCanCreateSystem(system) {
      return isSignedIn()
        && system in ['gbms', 'ghaneps', 'gifmis']
        && (request.auth.token.systems != null
          ? system in request.auth.token.systems
          // Accounts created before system claims were introduced are GBMS
          // requester accounts and must not be able to create PPA tickets.
          : system == 'gbms');
    }

    function userCanHandleSystem(userId, system) {
      let u = get(/databases/$(database)/documents/users/$(userId)).data;
      return u.keys().hasAny(['systems'])
        ? system in u.systems
        : system == 'gbms';
    }

    // Coordinator, Functional/Technical Lead, Management — cross-institution
    // visibility per Section 3. Vendor/specialist is deliberately excluded:
    // they only ever see tickets explicitly escalated to them.
    function isSupportSide() {
      return isSignedIn() && role() in [
        'support_coordinator', 'functional_lead', 'technical_lead', 'pfm_management'
      ];
    }

    function isVendor() {
      return isSignedIn() && role() == 'vendor_support';
    }

    // Functional/Technical Lead no longer get isSupportSide()'s blanket
    // cross-institution ticket visibility — they only ever see tickets
    // assigned to them (Technical Lead further narrowed to only the ones
    // that have actually been escalated, escalationLevel >= 1, mirroring
    // the functional/technical tier in TicketRepository.scopedQuery's
    // comment). Support Coordinator and Management keep full visibility —
    // Coordinator specifically must see unassigned tickets to assign them.
    function isFunctionalLead() {
      return isSignedIn() && role() == 'functional_lead';
    }

    function isTechnicalLead() {
      return isSignedIn() && role() == 'technical_lead';
    }

    // The two roles that keep cross-institution visibility over every
    // ticket regardless of assignment — was isSupportSide() before
    // Functional/Technical Lead were narrowed out of ticket access.
    function canViewAllTickets() {
      return isInstitutionAdmin();
    }

    // Mirrors the tickets/{id}/activity read rule below exactly — anyone who
    // can read a ticket's activity/chat trail is also who's allowed to read
    // or write their own read receipt on it (tickets/{id}/chatReceipts/{uid}).
    // A separate function (not a shared constant with the activity rule)
    // because it needs the ticket doc fetched once via [ticketId], usable
    // from chatReceipts' own match block.
    function canViewTicketChat(ticketId) {
      let t = get(/databases/$(database)/documents/tickets/$(ticketId)).data;
      return canViewAllTickets()
        // Every support-side administrator who can open the ticket queue can
        // also open the ticket's conversation. Keep this explicit here: the
        // chat stream is a subcollection and Firestore does not inherit the
        // parent ticket's read rule automatically.
        || (role() == 'support_coordinator' && hasAllowedSystem(ticketSystem(t)))
        || ((isFunctionalLead() || isTechnicalLead())
            && t.assignedTo == request.auth.uid
            && hasAllowedSystem(ticketSystem(t)))
        || (isVendor() && t.assignedTo == request.auth.uid && t.escalationLevel == 2 && hasAllowedSystem(ticketSystem(t)))
        || (isFocalPerson() && t.institutionId == institutionId())
        || (isRequesterSide() && t.createdBy == request.auth.uid);
    }

    function isRequesterSide() {
      return isSignedIn() && role() in ['end_user', 'mda_user', 'focal_person'];
    }

    function isFocalPerson() {
      return isSignedIn() && role() == 'focal_person';
    }

    function onlyFieldsChanged(fields) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(fields);
    }

    // ----- users -----
    // Profile fields are admin-managed (Section 5); clients never write
    // those. The exceptions are inherently self-service: a user registering
    // their own device's FCM token for push notifications (Section 7).
    match /users/{userId} {
      allow read: if isSignedIn()
        && (
          request.auth.uid == userId
          || isInstitutionAdmin()
          || ((isSupportSide() || isVendor()) && userHasAllowedSystem(resource.data))
        );
      allow update: if isSignedIn()
        && request.auth.uid == userId
        && onlyFieldsChanged(['fcmTokens', 'lastActiveAt', 'profilePhotoUrl']);
      allow create, delete: if false;
    }

    // ----- institutions -----
    // Was seed-only in the MVP; the Institutions screen (mobile + desktop)
    // needs to add new ones for real. That screen is reachable only via
    // `adminOnlyPaths` in app_router.dart (role == pfm_management exactly,
    // not the broader isSupportSide()) and has no other entry point, so the
    // rule matches that instead of the wider support-side set — otherwise a
    // Coordinator or Lead could write institutions directly even though the
    // app never offers them that action. Deletion stays closed — removing
    // an institution out from under users referencing it via institutionId
    // isn't a thing this app models a safe migration for.
    match /institutions/{institutionId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && role() == 'pfm_management';
      allow delete: if false;
    }

    // ----- app config (SLA policy, general settings, etc.) -----
    // A handful of admin-tunable settings docs (config/sla, config/general)
    // — readable by anyone signed in since they inform client-side
    // calculations (Overdue, SLA Compliance) and display (app name, date/
    // time format). Both writers (SlaManagementScreen, the desktop
    // Settings screen's General tab) live under `/admin-settings`, which
    // app_router.dart's adminOnlyPaths restricts to role == pfm_management
    // exactly (same reasoning as institutions above) — narrower than the
    // isSupportSide() this used to allow.
    match /config/{docId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && role() == 'pfm_management';
    }

    // ----- counters (ticket reference sequence) -----
    // TicketRepository.createTicket runs a client-side transaction against
    // counters/tickets_{year} to mint the human-readable PFMSD-YYYY-NNNNNN
    // reference. Restrict writes to incrementing `count` by exactly 1 so a
    // client can't forge arbitrary sequence numbers.
    match /counters/{counterId} {
      allow read: if isSignedIn();
      // `resource == null` on the first ticket of the year (counter doc
      // doesn't exist yet) must short-circuit before touching
      // resource.data — referencing a field on a null resource is a rules
      // evaluation error (denies the whole request), not a graceful falsy
      // value. Learned the hard way: this originally read
      // `resource.data.count is int ? resource.data.count : 0`, which still
      // evaluates resource.data.count eagerly and threw on the very first
      // write of every year.
      allow write: if isSignedIn()
        && request.resource.data.keys().hasOnly(['count'])
        && request.resource.data.count is int
        && (
          (resource == null && request.resource.data.count == 1)
          || (resource != null && request.resource.data.count == resource.data.count + 1)
        );
    }

    // ----- tickets -----
    match /tickets/{ticketId} {
      // Section 3: a plain User only sees tickets they personally logged; a
      // Focal Person sees every ticket from their institution. Functional and
      // Technical Lead (one Applications Systems Unit now) both see any ticket
      // assigned to them, at any escalation level — category auto-assignment
      // places level-0 tickets directly with an ASU member.
      allow read: if canViewAllTickets()
        || (role() == 'support_coordinator' && hasAllowedSystem(ticketSystem(resource.data)))
        || ((isFunctionalLead() || isTechnicalLead())
            && resource.data.assignedTo == request.auth.uid
            && hasAllowedSystem(ticketSystem(resource.data)))
        || (isVendor() && resource.data.assignedTo == request.auth.uid && resource.data.escalationLevel == 2 && hasAllowedSystem(ticketSystem(resource.data)))
        || (isFocalPerson() && resource.data.institutionId == institutionId())
        || (isRequesterSide() && resource.data.createdBy == request.auth.uid);

      // Only the requester side creates tickets, and only for their own
      // institution, as themselves, in the initial unassigned state.
      allow create: if isRequesterSide()
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.institutionId == institutionId()
        && requesterCanCreateSystem(ticketSystem(request.resource.data))
        && request.resource.data.status == 'open'
        && request.resource.data.escalationLevel == 0
        && request.resource.data.assignedTo == null;

      allow update: if (isInstitutionAdmin() || hasAllowedSystem(ticketSystem(resource.data)))
        && (request.resource.data.assignedTo == null
          || request.resource.data.assignedTo == resource.data.assignedTo
          || userCanHandleSystem(
            request.resource.data.assignedTo,
            ticketSystem(resource.data)
          ))
        &&
        // Support Coordinator may assign, escalate, and close, but only
        // through the specific ticket-field combinations below.
        (role() == 'support_coordinator' && (
          (onlyFieldsChanged(['assignedTo', 'status', 'updatedAt', 'resolvedAt', 'resolutionNotes'])
            && resource.data.status != 'closed'
            && request.resource.data.status == 'assigned'
            && request.resource.data.assignedTo != null)
          || (onlyFieldsChanged(['assignedTo', 'status', 'updatedAt', 'resolvedAt', 'resolutionNotes', 'escalationLevel'])
            && resource.data.status in ['open', 'assigned', 'in_progress', 'escalated', 'reopened']
            && request.resource.data.status == 'escalated'
            && request.resource.data.assignedTo != null
            && request.resource.data.escalationLevel > resource.data.escalationLevel)
          || (resource.data.status == 'resolved'
            && onlyFieldsChanged(['status', 'updatedAt', 'closedAt', 'closedBy'])
            && request.resource.data.status == 'closed')
        ))
        // PFM Management/Administrator can manually (re)assign a ticket —
        // same write TicketRepository.assignTicket() makes (assignedTo,
        // status -> 'assigned', updatedAt, plus clearing resolvedAt/
        // resolutionNotes when reassigning a resolved ticket) — and can
        // close a resolved ticket, matching the Close Ticket action
        // ticket_detail_screen.dart/desktop_ticket_detail_screen.dart now
        // offer assignment and closing to back-office roles. Reopening is
        // restricted to PFM Management. Escalate and priority-edit stay
        // Coordinator-only, per the comment above.
        || (role() == 'pfm_management'
            && ((resource.data.status != 'closed'
                 && onlyFieldsChanged(['assignedTo', 'status', 'updatedAt', 'resolvedAt', 'resolutionNotes'])
                 && request.resource.data.status == 'assigned')
                || (resource.data.status == 'resolved'
                    && onlyFieldsChanged(['status', 'updatedAt', 'closedAt', 'closedBy'])
                    && request.resource.data.status == 'closed')
                || (resource.data.status in ['resolved', 'closed']
                    && onlyFieldsChanged(['status', 'updatedAt', 'resolvedAt', 'resolutionNotes', 'closedAt', 'closedBy'])
            && request.resource.data.status == 'reopened')))
        // Vendor/Specialist's only granted action is resolving a ticket
        // escalated to them (Section 3: no assign/escalate/close) — the app
        // UI never offers those to Vendor, but the rule shouldn't rely on
        // the client to enforce it. escalationLevel == 2 mirrors the read
        // rule and TicketRepository.scopedQuery below: a ticket merely
        // assignedTo a vendor without also being at escalation level 2
        // isn't one they can see in the first place, so resolving it
        // shouldn't be reachable either.
        || (isVendor() && resource.data.assignedTo == request.auth.uid && resource.data.escalationLevel == 2
            && resource.data.status in ['assigned', 'in_progress', 'escalated', 'reopened']
            && onlyFieldsChanged(['status', 'updatedAt', 'resolutionNotes', 'resolvedAt'])
            && request.resource.data.status == 'resolved')
        // Functional/Technical Lead: Start Work, Resolve, self-service
        // escalate-up (to ASU/Vendor, capped at level 2), and Close (once
        // resolved) — matches the action set ticket_detail_screen.dart's
        // admin toolbar actually offers these roles. Assign/priority/
        // category edits stay Coordinator-only, per the comment above.
        || ((isFunctionalLead() || isTechnicalLead())
            && resource.data.assignedTo == request.auth.uid
            && resource.data.status in ['assigned', 'in_progress', 'escalated', 'reopened', 'resolved']
            && onlyFieldsChanged([
                 'status', 'updatedAt', 'resolvedAt', 'resolutionNotes',
                 'escalationLevel', 'assignedTo', 'closedAt', 'closedBy'
               ])
            && ((request.resource.data.status in ['in_progress', 'resolved', 'escalated'] && resource.data.status != 'resolved')
                || (request.resource.data.status == 'closed' && resource.data.status == 'resolved'))
            && request.resource.data.escalationLevel >= resource.data.escalationLevel
             && request.resource.data.escalationLevel <= 2);
        // Requesters (MDA/MMDA users and focal persons) have no ticket-update
        // path at all — reopening and closing are staff-only actions (see
        // ticket_detail_screen.dart's requester actions, which offer Chat
        // only). Once resolved, a ticket only moves again via staff closing
        // it; reopening is restricted to PFM Management.

      allow delete: if false; // tickets are closed, never deleted — audit trail must persist

      // ----- ticket activity (audit trail) -----
      match /activity/{activityId} {
        // The chat/timeline stream must use the same ticket-scoped decision
        // as the chat receipt stream; Firestore does not inherit the parent
        // ticket's access rule for subcollections.
        allow read: if canViewTicketChat(ticketId);

        // Every status-changing action must leave an activity record
        // (Section 8); anyone who can read the ticket can add one, but only
        // as themselves, and entries are immutable once written. Functional
        // and Technical Lead mirror the same assignedTo condition as the read
        // rule above — they shouldn't be able to write to a ticket's trail
        // they can't even open. Vendor mirrors the same escalationLevel == 2
        // gate as the read rule above, for the same reason.
        allow create: if canViewTicketChat(ticketId)
          && request.resource.data.actorId == request.auth.uid
          && request.resource.data.ticketId == ticketId;
        allow update, delete: if false;
      }

      // ----- chat read receipts (WhatsApp-style ticks) -----
      // One doc per participant: { lastReadAt }. Written only by that
      // participant, for themselves, whenever they view the chat — the
      // Delivered/Read ticks on a message you sent compare its timestamp
      // against the *other* participant's lastReadAt here.
      match /chatReceipts/{uid} {
        allow read: if canViewTicketChat(ticketId);
        allow create, update: if isSignedIn() && request.auth.uid == uid && canViewTicketChat(ticketId);
        allow delete: if false;
      }
    }

    // ----- notifications -----
    match /notifications/{notificationId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;

      // Every notification — ticket-lifecycle ones and admin broadcasts
      // alike — is written server-side by Cloud Functions via the Admin
      // SDK (onTicketCreated/onTicketUpdated, adminBroadcastNotification),
      // which bypasses these rules entirely. The client (announcements_
      // screen.dart) only ever calls the adminBroadcastNotification
      // callable, which independently re-checks role == pfm_management —
      // it never writes to this collection directly, so there is no
      // legitimate client-side create path to allow here.
      allow create: if false;

      allow update: if isSignedIn()
        && resource.data.userId == request.auth.uid
        && onlyFieldsChanged(['read']);

      allow delete: if false;
    }

    // ----- knowledge base -----
    match /knowledge_articles/{articleId} {
      // Draft/in-review articles are editor-only — a requester who has,
      // guesses, or is linked a draft's id must not be able to read its
      // unpublished content directly (the app's own list screens already
      // filter to published-only for non-editors, but that's a client-side
      // UI filter, not an access boundary; this is the real one).
      allow read: if isSignedIn() && (resource.data.status == 'published' || isSupportSide());
      allow create, delete: if isSupportSide();
      // Any signed-in reader may bump viewCount when they open an article
      // (real "most viewed" data, not a fabricated number) — every other
      // field stays editor-only.
      allow update: if isSupportSide() || (isSignedIn() && onlyFieldsChanged(['viewCount']));
    }

    // ----- report views (Reports screen "Recent Reports" log) -----
    // Reports are computed live from ticket data, not exported/stored
    // files (no Storage yet) — this just logs which report types a given
    // admin looked at recently, scoped strictly to themselves.
    match /report_views/{viewId} {
      allow read: if isSupportSide() && resource.data.viewedBy == request.auth.uid;
      allow create: if isSupportSide() && request.resource.data.viewedBy == request.auth.uid;
      allow update, delete: if false;
    }

    // ----- access requests (RequestAccessScreen) -----
    // Deliberately the one collection writable by a signed-OUT client —
    // this is the pre-auth "request an account" form. It's a request, not
    // an account: nothing here creates a login. Only PFM-Systems can read
    // the queue (no review UI built yet — see DECISIONS.md); no client can
    // update/delete once submitted.
    match /access_requests/{requestId} {
      allow create: if request.resource.data.keys().hasOnly(
        ['fullName', 'email', 'phone', 'institutionType', 'institutionName', 'status', 'submittedAt']
      ) && request.resource.data.status == 'pending';
      // Access requests are a tenant-neutral provisioning queue, so keep it
      // restricted to the tenant-wide administrator rather than exposing it
      // to product-scoped coordinators or APPS members.
      allow read: if isInstitutionAdmin();
      allow update, delete: if false;
    }

    // ----- system audit log (admin actions) -----
    // Written only by Cloud Functions (Admin SDK); readable by management
    // for oversight.
    match /audit_logs/{logId} {
      // Admin actions are tenant-wide user-management records. Product staff
      // must not receive another system's user-management history.
      allow read: if isInstitutionAdmin();
      allow write: if false;
    }

    // ----- Audit Logs desktop screen (collection-group read) -----
    // AuditLogRepository.watchRecent() runs a collectionGroup('activity')
    // query across every ticket's activity subcollection. The per-ticket
    // `allow read` above only governs direct reads scoped to one ticket's
    // subcollection — Firestore requires a separate wildcard-path rule for
    // collection-group queries to be permitted at all. Must mirror the
    // per-ticket rule's scoping exactly (Coordinator/Management see
    // everything; Functional/Technical Leads only their assigned systems),
    // not just isSupportSide() — this keeps the collection-group rule
    // aligned with the per-ticket system boundary.
    match /{path=**}/activity/{activityId} {
      allow read: if canViewAllTickets()
        || (role() == 'support_coordinator'
            && hasAllowedSystem(ticketSystem(get(/databases/$(database)/documents/tickets/$(resource.data.ticketId)).data)))
        || ((isFunctionalLead() || isTechnicalLead())
            && get(/databases/$(database)/documents/tickets/$(resource.data.ticketId)).data.assignedTo == request.auth.uid
            && hasAllowedSystem(ticketSystem(get(/databases/$(database)/documents/tickets/$(resource.data.ticketId)).data)));
    }
  }
}
