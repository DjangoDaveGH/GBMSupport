# This repo is public. These carry real people's names/emails/phone numbers
# and/or the literal shared default account password — never committed,
# regardless of what else gets swept up by a broad `git add`. Rather than
# name every one-off bulk-import script, backup dump, and source
# spreadsheet individually as they accumulate, the patterns below cover the
# whole category; see git history for the specific files this replaced.
/scripts/login_emails.csv
/scripts/training_users.json
/scripts/import_training_users.js
/scripts/create_missing_apps_unit.js
/scripts/fix_apps_unit_institution.js
/scripts/update_isha_email.js
/scripts/reset_apps_unit_passwords.js
/scripts/generate_login_emails.js
/APP UNIT MEN.xlsx
/Group 1&2 Training Participants.xlsx
/scripts/*_users.json
/scripts/*_login_emails.csv
/scripts/ticket_backup_*.json
/scripts/*_users.js
*.xlsx
*.docx

