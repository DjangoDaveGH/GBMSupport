#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Local dev scripts (scripts/seed.js) — service account key is a secret
# credential and must never be committed.
/scripts/service-account.json
/scripts/node_modules/

# Cloud Functions build artifacts
/functions/node_modules/

# Firebase CLI local deploy cache — not meant for version control.
/.firebase/
